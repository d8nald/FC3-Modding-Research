            <MinimapGen name="1" texSize="128,128" MeterPerPixel="0.5" palette="Default" InvertY="1" DirOutput="MiniMaps/%1%/" FileOutput="%2%.png" SectorNumConvert="%i" CoordConvert="%02i"/>
        </MinimapGenerate>
    </MinimapConfig>
    
    <ConfigObjectMap>
