    <MinimapConfig >
        <MinimapPalettes>
            <MinimapPalette name="Default">
                <!-- Top color is color at height 1024 (max height) and zero color is at ocean level (max - Ocean lvl) -->
                <TerrainColorInfos Granularity="4" BottomColor="dbe4cf" TopColor="1f3025" >
                    <ColorInfos>
                        <ColorHeight HeightPlateau="10" Color="bdd0a7" />
                        <ColorHeight HeightPlateau="20" Color="a2bc84" />
                        <ColorHeight HeightPlateau="30" Color="71886b" />
                        <ColorHeight HeightPlateau="40" Color="43594a" />
                    </ColorInfos>
                </TerrainColorInfos>

                <!-- Top color is color at ocean level and bottom color is at 0 height -->
                <OceanColorInfos Granularity="2" BottomColor="000000" TopColor="c0e0db" >
                    <ColorInfos>
                        <ColorHeight HeightPlateau="-5" Color="61b9b0" />
                        <ColorHeight HeightPlateau="-10" Color="1e7c71" />
                        <ColorHeight HeightPlateau="-15" Color="0c4d46" />
                    </ColorInfos>
                </OceanColorInfos>

                <!-- Top color is color at a sector water level and bottom color is at ocean level height -->
                <WaterColorInfos Granularity="1" BottomColor="1e7c71" TopColor="c0e0db" >
                    <ColorInfos>
                        <ColorHeight HeightPlateau="-5" Color="61b9b0" />
                    </ColorInfos>
                </WaterColorInfos>            
            </MinimapPalette>
        </MinimapPalettes>

        <MinimapGenerate>
            <MinimapGen Name="5" TexSize="512,512" MeterPerPixel="0.5" Palette="Default" InvertY="1" />
