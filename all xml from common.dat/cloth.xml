<?xml version="1.0" encoding="utf-8"?>
<materialdescriptor xmlns:xi="#" name="Cloth" id="#(0x543bdc8d, 0x6358dfd2)" version="6">
    <geometryInputs normal="1" tangent="1" binormal="1" color="1" uvChannels="2" />

    <parameter name="AlphaTestEnabled" type="bool" />
    <parameter name="TwoSided" type="bool" />
    <parameter name="AmbientOcclusion" type="float" />

    <!-- As of 2009/06/04, the cloth shader uses
         - Vertex color BLUE to modulate the diffuse color by the two base colors (diffuseColor.rgb *= lerp( BaseColor1, BaseColor2, vertexMask.b ))
         - Mask channel GREEN and vertex color GREEN to modulate the fabric texture with the print texture (diffuseColor.rgb = lerp (diffuseColor.rgb, tex2D( PrintTexture, LERP_SWITCH(uvs, GROUP2) * PrintTiling ), vertexMask.g * pixelMask.g))
         - Vertex color RED to modulate the diffuse color with the blood texture (diffuseColor.rgb *= lerp (1, tex2D( BloodTexture, LERP_SWITCH(uvs, GROUP3) * BloodTiling), vertexMask.r))
         - Mask channel BLUE and vertex color BLUE to modulate the normal (NORMAL = lerp(float3(0, 0, 1), NormalTexture1, MASK_BLUE*VERTEX_BLUE))
         - Mask channel RED to modulate the specular map (specularColor = lerp( specularColor, specularMap * SpecularColor1, pixelMask.r ))
    -->

    <parameter name="FabricTexture" type="sampler2D" tilingName="FabricTiling" UvName="UVGroupMapChannel1" />
    <parameter name="FabricTiling" type="float2" />
    <parameter name="BaseColor1" type="color4" color="1" />
    <parameter name="BaseColor2" type="color4" color="1" />

    <parameter name="PrintTexture" type="sampler2D" tilingName="PrintTiling" UvName="UVGroupMapChannel2" VCMaskChannel="8" />
    <parameter name="PrintTiling" type="float2" />
    
    <parameter name="BloodTexture" type="sampler2D" tilingName="BloodTiling1" UvName="UVGroupMapChannel3" VCMaskChannel="12" />
    <parameter name="BloodTiling" type="float2" />

    <parameter name="MaskTexture1" type="sampler2D" UvName="UVGroupMapChannel0" />

    <parameter name="NormalTexture1" type="sampler2D" UvName="UVGroupMapChannel1" />
    
    <parameter name="SpecularTexture1" type="sampler2D" tilingName="SpecularTiling1" UvName="UVGroupMapChannel1" VCMaskChannel="1" />
    <parameter name="SpecularTiling1" type="float2" />
    <parameter name="SpecularColorBase" type="color4" color="1" />
    <parameter name="SpecularColor1" type="color4" color="1" />
    <parameter name="SpecularPower" type="float" displayInMax="1" />
    
    <parameter name="UVGroupMapChannel0" type="float" />
    <!-- UVGroupMapChannel1 is used by three textures! -->
    <parameter name="UVGroupMapChannel1" type="float" />
    <parameter name="UVGroupMapChannel2" type="float" />
    <parameter name="UVGroupMapChannel3" type="float" />
    
    <parameter name="RimLightTexture" type="sampler2D" />
  
    <parameter name="WetnessLightingCffs" type="float4" defaultvalue="0.5,2.0,2.0,0.0"/>

    <parameterprovider parametersfilename="Mesh_Cloth.parameters.inc.fx">
        <parameter name="AmbientOcclusion" />
        <parameter name="FabricTexture" />
        <parameter name="FabricTiling" />
        <parameter name="BaseColor1" />
        <parameter name="BaseColor2" />
        <parameter name="PrintTexture" />
        <parameter name="PrintTiling" />
        <parameter name="BloodTexture" />
        <parameter name="BloodTiling" />
        <parameter name="MaskTexture1" />
        <parameter name="NormalTexture1" />
        <parameter name="SpecularTexture1" />
        <parameter name="SpecularTiling1" />
        <parameter name="SpecularColorBase" />
        <parameter name="SpecularColor1" />
        <parameter name="SpecularPower" />
        <parameter name="UVGroupMapChannel0" />
        <parameter name="UVGroupMapChannel1" />
        <parameter name="UVGroupMapChannel2" />
        <parameter name="UVGroupMapChannel3" />
        <parameter name="RimLightTexture" />
        <parameter name="WetnessLightingCffs" />    
    </parameterprovider>
    
    <ui>
        <group horizontal="1">
            <checkbox label="Two sided" dataBindings="TwoSided" />
            <checkbox label="Alpha test" dataBindings="AlphaTestEnabled" />
            <label>Ambient occlusion</label>
            <textbox dataBindings="AmbientOcclusion">
                <dataBindings maxvalue="1" />
            </textbox>
        </group>

        <group label="Fabric" horizontal="1">
            <button dataBindings="FabricTexture" fill="1" />
            <group>
                <textbox dataBindings="FabricTiling.x">
                    <dataBindings type="int" />
                </textbox>
                <textbox dataBindings="FabricTiling.y">
                    <dataBindings type="int" />
                </textbox>
            </group>
        </group>

        <group label="Colors" horizontal="1">
            <label>Base Color 1</label>
            <button dataBindings="BaseColor1">
                <dataBindings type="color" />
            </button>
            <label>Base Color 2</label>
            <button dataBindings="BaseColor2">
                <dataBindings type="color" />
            </button>
        </group>

        <group label="Print" horizontal="1">
            <button dataBindings="PrintTexture" fill="1" />
            <group>
                <textbox dataBindings="PrintTiling.x">
                    <dataBindings type="int" />
                </textbox>
                <textbox dataBindings="PrintTiling.y">
                    <dataBindings type="int" />
                </textbox>
            </group>
        </group>

        <group label="Blood" horizontal="1">
            <button dataBindings="BloodTexture" fill="1" />
            <group>
                <textbox dataBindings="BloodTiling.x">
                    <dataBindings type="int" />
                </textbox>
                <textbox dataBindings="BloodTiling.y">
                    <dataBindings type="int" />
                </textbox>
            </group>
        </group>

        <group label="Mask texture">
            <button dataBindings="MaskTexture1" fill="1" />
        </group>

        <group label="Normal texture">
            <button dataBindings="NormalTexture1" fill="1" />
        </group>

        <group label="Specular">
            <group horizontal="1">
                <button dataBindings="SpecularColor1">
                    <dataBindings type="color" />
                </button>
                <button dataBindings="SpecularTexture1" fill="1" />
                <group>
                    <textbox dataBindings="SpecularTiling1.x">
                        <dataBindings type="int" />
                    </textbox>
                    <textbox dataBindings="SpecularTiling1.y">
                        <dataBindings type="int" />
                    </textbox>
                </group>
            </group>

            <group horizontal="1">
                <button dataBindings="SpecularColorBase" fill="1" >
                    <dataBindings type="color" />
                </button>
                <label>Power</label>
                <textbox databindings="SpecularPower" />
            </group>
        </group>

        <group label="Rim light texture">
            <button dataBindings="RimLightTexture" fill="1" />
        </group>
        
        <xi:include href="../WetnessUIInclude.xml" />    
    </ui>
        
</materialdescriptor>