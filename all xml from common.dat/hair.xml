<?xml version="1.0" encoding="utf-8"?>
<materialdescriptor xmlns:xi="#" name="Hair" id="#(0x414c4b93, 0xb23a7f2)" version="7">
    <geometryInputs normal="1" tangent="1" binormal="1" color="1" uvChannels="2" />

    <parameter name="AlphaTestEnabled" type="bool" />
    <parameter name="TwoSided" type="bool" />
    <parameter name="BlendingType" type="int" />

    <!-- As of 2009/06/04, the hair shader uses
         - Vertex color RED to modulate the diffuse color (diffuseColor.rgb = diffuseMapBase * DiffuseColor1 * mask.r)
    -->

    <parameter name="DiffuseTexture1" type="sampler2D" tilingName="DiffuseTiling1" UvName="UVGroupMapChannel1" VCMaskChannel="12" />
  
    <parameter name="DiffuseTiling1" type="float2" />
    <parameter name="DiffuseColorBase" type="color4" color="1" defaultvalue="1,1,1,1" />
    <parameter name="DiffuseColor1" type="color4" color="1" defaultvalue="1,1,1,1" />
    <parameter name="DiffuseTexture1Priority" type="int" defaultvalue="1" />
    <parameter name="OmniSpotLightingDisabled" type="bool" />

    <parameter name="SpecularTexture1" type="sampler2D" tilingName="SpecularTiling1" UvName="UVGroupMapChannel1" />
    <parameter name="SpecularTiling1" type="float2" />
    <parameter name="SpecularColorBase" type="color4" color="1" />
    <parameter name="SpecularColor1" type="color4" color="1" />
    <parameter name="SpecularPower" type="float" defaultvalue="16" />
    <parameter name="AnisotropicPower" type="float" defaultvalue="1.0" />
    <parameter name="AnisotropicColoration" type="float" defaultvalue="1.0" />
    <parameter name="HairShift" type="float" defaultvalue="0.0" />
    <parameter name="SpecularTexture1Priority" type="int" defaultvalue="4" />
    <parameter name="FresnelPower" type="float" defaultvalue="16" />
    <parameter name="FresnelColor" type="color4" />

    <parameter name="BlurParams" type="float4" defaultvalue="1,1,100,0" />
    
  <parameter name="NormalTexture1" type="sampler2D" tilingName="NormalTiling1" UvName="UVGroupMapChannel3" />
    <parameter name="NormalTiling1" type="float2" />
    <parameter name="NormalTexture1Priority" type="int" defaultvalue="3" />
  <parameter name="NormalStrength" type="float" defaultvalue="1.0" />
    <parameter name="ResultLightingTexture" type="sampler2D" />

    <!-- UVGroupMapChannel1 is used by two textures! -->
    <parameter name="UVGroupMapChannel1" type="int" />
    <parameter name="UVGroupMapChannel2" type="int" />
    <parameter name="UVGroupMapChannel3" type="int" />

    <parameter name="DiffuseTiling1AndGroup1" type="float4" defaultvalue="1,1,0,0" />
    <!-- DiffuseTiling2AndGroup2 is used but it's never assigned a value!! -->
    <parameter name="DiffuseTiling2AndGroup2" type="float4" defaultvalue="1,1,0,0" />
    <parameter name="NormalTiling1AndGroup3" type="float4" defaultvalue="1,1,0,0" />
    <parameter name="SpecularTiling1AndGroup1" type="float4" defaultvalue="1,1,0,0" />

    <parameter name="WetnessLightingCffs" type="float4" defaultvalue="0.5,2.0,2.0,0.0"/>
    <parameter name="AllowDistanceBoost" type="bool" defaultvalue="1" useDefine="ALLOWDISTANCEBOOST" />
    <parameterprovider parametersfilename="Mesh_Hair.parameters.inc.fx">
        <parameter name="DiffuseTexture1" />
        

      <parameter name="DiffuseColorBase" />
        <parameter name="DiffuseColor1" />
        <parameter name="DiffuseTexture1Priority" />
        <parameter name="OmniSpotLightingDisabled" />
        <parameter name="SpecularTexture1" />
        <parameter name="SpecularColorBase" />
        <parameter name="SpecularColor1" />
        <parameter name="SpecularPower" />
        <parameter name="AnisotropicPower" />
        <parameter name="AnisotropicColoration" />
        <parameter name="HairShift" />
        <parameter name="FresnelPower" />
        <parameter name="BlurParams" />
        <parameter name="FresnelColor" />
        <parameter name="NormalTexture1" />
        <parameter name="NormalTexture1Priority" />
        <parameter name="NormalStrength" />
        <parameter name="DiffuseTiling1AndGroup1" />
        <parameter name="DiffuseTiling2AndGroup2" />
        <parameter name="NormalTiling1AndGroup3" />
        <parameter name="SpecularTiling1AndGroup1" />
        <parameter name="WetnessLightingCffs" />    
        <parameter name="AllowDistanceBoost"/>
    </parameterprovider>
    
    <ui>
        <group horizontal="1" label="Settings">
            <group>
                <checkbox label="Two sided" dataBindings="TwoSided" />
                <checkbox label="Alpha test" dataBindings="AlphaTestEnabled" />
            </group>
            <group>
                <label>Blending type</label>
                <combobox dataBindings="BlendingType">
                    <comboboxitem value="0">Opaque</comboboxitem>
                    <comboboxitem value="1">Alpha</comboboxitem>
                </combobox>
            </group>
            <checkbox label="Omni/Spot Lighting Disabled" dataBindings="OmniSpotLightingDisabled" />
        </group>

        <group label="Diffuse">
            <group horizontal="1">
                <button dataBindings="DiffuseColor1">
                    <dataBindings type="color" />
                </button>
                <button dataBindings="DiffuseTexture1" fill="1" />
                <textbox dataBindings="UVGroupMapChannel1">
                    <dataBindings type="int" maxvalue="1" />
                </textbox>
                <group>
                    <textbox dataBindings="DiffuseTiling1.x">
                        <dataBindings type="int" />
                    </textbox>
                    <textbox dataBindings="DiffuseTiling1.y">
                        <dataBindings type="int" />
                    </textbox>
                </group>
            </group>

            <button dataBindings="DiffuseColorBase" fill="1">
                <dataBindings type="color" />
            </button>
        </group>

        <group label="BlurDirection" horizontal="1">
        <label>X</label>
        <textbox databindings="BlurParams.x" />
        <label>Y</label>
        <textbox databindings="BlurParams.y" />
        <label>Strenght 1-100 </label>
        <textbox databindings="BlurParams.z" maxvalue="100" decimals="1"  />
        <label>Spread </label>
        <textbox databindings="BlurParams.w" maxvalue="1" decimals="0"  />


      </group>
      
        <group label="Fresnel" horizontal="1">
            <label>Power</label>
            <textbox databindings="FresnelPower" />
            <label>Color</label>
            <button dataBindings="FresnelColor">
                <dataBindings type="color" />
            </button>
        </group>
        
        <group label="Specular">
            <group horizontal="1">
                <button dataBindings="SpecularColor1">
                    <dataBindings type="color" />
                </button>
                <button dataBindings="SpecularTexture1" fill="1" />
                <group>
                    <textbox dataBindings="SpecularTiling1.x">
                        <dataBindings type="int" />
                    </textbox>
                    <textbox dataBindings="SpecularTiling1.y">
                        <dataBindings type="int" />
                    </textbox>
                </group>
            </group>

            <group horizontal="1">
             
                <label>HairShift</label>
    
              <textbox databindings="HairShift">
                <dataBindings type="float"  minvalue="0" maxvalue="1" />
              </textbox>
               <label>AnisotropicPower</label>
                <textbox databindings="AnisotropicPower"> 
                  <dataBindings type="float" maxvalue="1" />
                </textbox>
               <label>AnisotropicColoration</label>
               <label>->Lerp ( white , color hair )</label>
                <textbox databindings="AnisotropicColoration"> 
                  <dataBindings type="float" maxvalue="1" />
                </textbox>
                </group>
        </group>
      <group horizontal="1" label="AllowDistanceBoost">
        <checkbox label="Enable" dataBindings="AllowDistanceBoost" tooltop="Allow distance boost" />
      </group>
        <group horizontal="1" label="Normal">
            <button dataBindings="NormalTexture1" fill="1" />
            <textbox dataBindings="UVGroupMapChannel3">
                <dataBindings type="int" maxvalue="1" />
            </textbox>
            <group>
                <textbox dataBindings="NormalTiling1.x">
                    <dataBindings type="int" />
                </textbox>
                <textbox dataBindings="NormalTiling1.y">
                    <dataBindings type="int" />
                </textbox>
            </group>
			           <label>NormalStrength</label>
                <textbox databindings="NormalStrength"> 
                  <dataBindings type="float" maxvalue="4" />
                </textbox>
        </group>
        
        <xi:include href="../WetnessUIInclude.xml" />    
    </ui>
    
</materialdescriptor>
