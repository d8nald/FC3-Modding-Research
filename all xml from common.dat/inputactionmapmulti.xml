	<ActionMap name="spectating_controls">
		<Binding input="pad:right_trigger" action="press" signal="next_player"/>
		<Binding input="pad:left_trigger" action="press" signal="previous_player"/>
		<Binding input="mouse:lb" action="press" signal="next_player"/>
        <Binding input="mouse:rb" action="press" signal="previous_player"/>
		<PadFilter name="left_thumb" device="pad">
			<Binding input="left_thumb_leftright" axis="0" sensitivity="1.0" curve="Player:MovementCurves/Movement_leftright"/>
			<Binding input="left_thumb_updown" axis="1" sensitivity="1.0" curve="Player:MovementCurves/Movement_updown"/>
		</PadFilter>
		<Binding input="pad:left_thumb" action="update" signal="spectating_look"/>
		<PadFilter name="right_thumb" device="pad">
			<Binding input="right_thumb_leftright" axis="0" sensitivity="1.0" curve="Player:MovementCurves/Movement_leftright"/>
			<Binding input="right_thumb_updown" axis="1" sensitivity="1.0" curve="Player:MovementCurves/Movement_updown"/>
		</PadFilter>
		<Binding input="pad:right_thumb" action="update" signal="spectating_look"/>

		<MouseFilter input="mouse:move" sensitivity="1.0" maxOutput="15" />
		<Binding input="mouse:move" action="update" signal="spectating_look"/>
		
		<Binding input="pad:a" action="press" signal="freecam"/>
		<Binding input="kb:e" action="press" signal="freecam"/>
	</ActionMap>

	<ActionMap name="killcam_controls">
        <Binding input="kb:space" action="press" signal="cancel_Killcam"/>
        <Binding input="mouse:lb" action="press" signal="cancel_Killcam"/>
        <Binding input="mouse:rb" action="press" signal="cancel_Killcam"/>
		<Binding input="pad:b" action="press" signal="cancel_Killcam" />

		<PadFilter name="left_thumb" device="pad">
			<Binding input="left_thumb_leftright" axis="0" sensitivity="1.0" curve="Player:MovementCurves/Movement_leftright"/>
			<Binding input="left_thumb_updown" axis="1" sensitivity="1.0" curve="Player:MovementCurves/Movement_updown"/>
		</PadFilter>
		<Binding input="pad:left_thumb" action="update" signal="killcam_look"/>
		<PadFilter name="right_thumb" device="pad">
			<Binding input="right_thumb_leftright" axis="0" sensitivity="1.0" curve="Player:MovementCurves/Movement_leftright"/>
			<Binding input="right_thumb_updown" axis="1" sensitivity="1.0" curve="Player:MovementCurves/Movement_updown"/>
		</PadFilter>
		<Binding input="pad:right_thumb" action="update" signal="killcam_look"/>

		<MouseFilter input="mouse:move" sensitivity="1.0" maxOutput="15" />
		<Binding input="mouse:move" action="update" signal="killcam_look"/>
	</ActionMap>

