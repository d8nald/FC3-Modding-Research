	<ActionMap name="InGameDecisionWheel" resendOnChange="0">
		<Import actionmap="system"/>
		<Import actionmap="basic"/>
		<Import actionmap="common_move_remap" optional=""/>
		<CompoundInput name="right_thumb" device="pad">
			<Binding input="right_thumb_leftright" axis="1"/>
			<Binding input="right_thumb_updown" axis="0"/>
		</CompoundInput>
		<Binding input="pad:right_thumb" action="update" signal="left_thumb_move"/>
		<Binding input="pad:back" action="release" signal="wheel_deactivated"/>
		<Binding input="kb:v" action="release" signal="wheel_deactivated"/>

		<Binding input="mouse:rb" action="press" signal="startironsight"/>
		<Binding input="mouse:rb" action="release" signal="stopironsight"/>
		<Binding input="pad:left_trigger" action="press" signal="startironsight"/>
		<Binding input="pad:left_trigger" action="release" signal="stopironsight"/>

		<MouseFilter input="mouse:move" sensitivity="1.0" maxOutput="15" />
		<Binding input="mouse:move" action="update" signal="mouse_move"/>

	</ActionMap>

 	<ActionMap name="InGameMenu" resendOnChange="0">
			<Import actionmap="showconsole"/>
    	<Binding input="pad:left_shoulder"				action="press"	signal="press_left_shoulder"/>
    	<Binding input="pad:right_shoulder"				action="press"	signal="press_right_shoulder"/>
			<Binding input="pad:b" 										action="press" 	signal="toggle_ingamemenu"/>
      <NoResend input="pad:b"/>
      <Binding input="kb:escape" 								action="press" 	signal="toggle_ingamemenu"/>
      <NoResend input="kb:escape"/>
      <Binding input="pad:start" 								action="press" 	signal="toggle_ingamemenu"/>
      <NoResend input="pad:start"/>
	</ActionMap>


	 <ActionMap name="end_sequence_mp_idle" resendOnChange="0">
		<Import actionmap="system" />
        <Import actionmap="openchat"/>
		<Import actionmap="scoreboard_on_off" />
	</ActionMap>

	<ActionMap name="end_sequence_mp" resendOnChange="0">
		<Import actionmap="end_sequence_mp_idle"/>

		<!--PC-->
		<Binding input="mouse:lb" action="press" signal="try_end_sequence_insult" />
		<Binding input="mouse:rb" action="press" signal="try_end_sequence_honor" />

		<!--XBox-->
		<Binding input="pad:right_trigger" action="press" signal="try_end_sequence_insult" />
		<Binding input="pad:left_trigger" action="press" signal="try_end_sequence_honor" />

		<!--PS3-->
		<Binding input="pad:right_shoulder" action="press" signal="try_end_sequence_insult_ps3" />
		<Binding input="pad:left_shoulder" action="press" signal="try_end_sequence_honor_ps3" />
	</ActionMap>

    <ActionMap name="MessageBox">
      <Import actionmap="common_MessageBox"/>
    </ActionMap>

    <ActionMap name="deploy_support_weapon" resendOnChange="0">
		<Import actionmap="system" />
		<Import actionmap="scoreboard_on_off" />
		<Import actionmap="menus"/>

		<Binding input="mouse:rb" action="press" signal="startzoom"/>
		<Binding input="mouse:rb" action="release" signal="stopzoom"/>
        <Binding input="pad:left_trigger" action="press" signal="startzoom"/>
		<Binding input="pad:left_trigger" action="release" signal="stopzoom"/>

        <!--Mouse look-->
		<MouseFilter input="mouse:move" sensitivity="1.0" maxOutput="10" />
		<Binding input="mouse:move" action="update" signal="camera_look"/>

        <!--Look on pad-->
		<PadFilter name="right_thumb" device="pad" padAccelerationBoostAmplitude="0" >
			<Binding input="right_thumb_leftright" axis="0" sensitivity="1.0" curve="Weapons:AimCurves/Pad_LookLeftRight"/>
			<Binding input="right_thumb_updown" axis="1" sensitivity="1.0" curve="Weapons:AimCurves/Pad_LookUpDown"/>
		</PadFilter>
		<Binding input="pad:right_thumb" action="update" signal="camera_look"/>

        <Binding input="mouse:lb" action="press" signal="deploySupportWeapon"/>
        <Binding input="pad:right_trigger" action="press" signal="deploySupportWeapon"/>

	</ActionMap>

    <ActionMap name="firestorm_ignite">
        <Import actionmap="gameplay"/>
        <Import actionmap="menus"/>

        <Binding input="pad:b" action="press" signal="firestorm_try_abort"/>
        <Binding input="kb:space" action="press" signal="firestorm_try_abort"/>
    </ActionMap>
	
	<ActionMap name="firestorm_camera">
		<Import actionmap="system"/>
		<Import actionmap="scoreboard_on_off"/>
	</ActionMap>

	<ActionMap name="postloadingscreen">
		<Import actionmap="system" />
        <Binding input="pad:a" 					action="press" signal="hide_postScreen_key1"/>
		<Binding input="pad:left_trigger" 		action="press" signal="hide_postScreen_key2"/>

		<Binding input="pad:b" 					action="press" signal="hide_postScreen_wrong_key"/>
		<Binding input="pad:x" 					action="press" signal="hide_postScreen_wrong_key"/>
		<Binding input="pad:y" 					action="press" signal="hide_postScreen_wrong_key"/>

		<Binding input="pad:right_shoulder" 	action="press" signal="hide_postScreen_wrong_key"/>
		<Binding input="pad:left_shoulder" 		action="press" signal="hide_postScreen_wrong_key"/>

		<Binding input="pad:right_trigger" action="press" signal="hide_postScreen_wrong_key" />
    </ActionMap>
</Root>
