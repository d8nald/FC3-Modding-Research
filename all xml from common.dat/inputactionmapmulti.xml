<Root>
    <Import file="ActionMaps\InputActionMapCommon.xml"/>

    <ActionMap name="showconsole" >
        <Import actionmap="common_showconsole"/>
    </ActionMap>

    <ActionMap name="openchat" >
		<Import actionmap="common_multiplayer_remap" optional=""/>
        <Binding input="kb:u" action="press" signal="open_chat"/>
		<Binding input="kb:rshift" action="press" signal="toggle_open_chat_team_on"/>
		<Binding input="kb:rshift" action="release" signal="toggle_open_chat_team_off"/>
    </ActionMap>

    <ActionMap name="show_loadout" >
        <Binding input="kb:l" action="press" signal="open_loadout"/>
    </ActionMap>

	<ActionMap name="at_Gate">
        <Import actionmap="system"/>
    </ActionMap>

    <ActionMap name="system" resendOnChange="0" >
        <UnShift />
        <Import actionmap="showconsole"/>
        <Import actionmap="common_scry_alwaysactive"/>
        <Import actionmap="common_system"/>
        <Import actionmap="common_chat_remap" optional=""/>
        <Import actionmap="common_vote_remap" optional=""/>

        <Binding input="kb:f1" action="press" signal="active_camerafirst"/>
        <Binding input="kb:f2" action="press" signal="active_camerathird"/>
        <Binding input="kb:f11" action="press" signal="active_camerafirst"/>

        <Binding input="kb:o" action="press" signal="active_cameraorbital"/>
        <Binding input="kb:i" action="press" signal="active_camerafocusedfree"/>
        <Binding input="kb:n" action="press" signal="active_camerahelicopter"/>

        <!-- Switch state -->
		<Binding input="kb:f6" action="release" signal="gr_next_state"/>

        <!--Chat-->
		<Binding input="kb:t" action="press" signal="start_global_chat"/>
		<Binding input="kb:y" action="press" signal="start_team_chat"/>

    </ActionMap>

    <ActionMap name="kb_move" >
        <Import actionmap="system"/>
    </ActionMap>

    <ActionMap name="move" >
        <Import actionmap="system"/>
        <Import actionmap="common_move"/>
    </ActionMap>

    <ActionMap name="look" >
        <Import actionmap="system"/>
        <Import actionmap="common_look"/>

		<PadFilter name="right_thumb" device="pad" padAccelerationBoostAmplitude="0" >
			<IronSightHelper>
			</IronSightHelper>
			<ShootCorrectionHelper/>
			<Binding input="right_thumb_leftright" axis="0" sensitivity="1.0" curve="Weapons:AimCurves/Pad_LookLeftRight"/>
			<Binding input="right_thumb_updown" axis="1" sensitivity="1.0" curve="Weapons:AimCurves/Pad_LookUpDown"/>
		</PadFilter>
		<Binding input="pad:right_thumb" action="update" signal="look"/>

    </ActionMap>

    <ActionMap name="carry">
		<Import actionmap="menus"/>
        <Import actionmap="look"/>
        <Import actionmap="move"/>
		<Import actionmap="openchat"/>
		<Import actionmap="common_heal_remap" optional=""/>

        <Binding input="pad:b" action="press" signal="drop_carriable"/>
		<Binding input="kb:b" action="press" signal="drop_carriable"/>
		<Binding input="pad:x" action="hold" signal="use"/>
        <Binding input="kb:e" action="press" signal="use"/>
		<Binding input="kb:t" action="press" signal="try_tactic"/>
		<Binding input="pad:left_thumb_push" 	action="press" signal="try_tactic_combo_1" secondary="1"/>
		<Binding input="pad:right_thumb_push" 	action="press" signal="try_tactic_combo_2" secondary="1"/>

		<Binding input="kb:v" action="hold" signal="label_entity_option"/>
		<Binding input="pad:back" action="hold" signal="label_entity_option"/>

		<Binding input="kb:v" action="press" signal="label_entity"/>
		<Binding input="pad:back" action="press" signal="label_entity"/>

		<Binding input="kb:v" action="release" signal="label_entity_release"/>
		<Binding input="pad:back" action="release" signal="label_entity_release"/>

		<!--Keyboard-->
		<Binding input="kb:q" action="press" signal="heal"/>
		<Binding input="kb:q" action="release" signal="heal_release"/>

		<!--Gamepad-->
		<Binding input="pad:y" action="press" signal="heal"/>
        <Binding input="pad:y" action="release" signal="heal_release"/>

    </ActionMap>

	<ActionMap name="weapon_select_mp">
		<Import actionmap="common_weapons_remap" optional=""/>
		<Import actionmap="common_multiplayer_remap" optional=""/>

		<Binding input="kb:-" action="press" signal="select_previous_weapon"/>
		<Binding input="kb:=" action="press" signal="select_next_weapon"/>
        <Binding input="kb:x" action="press" signal="select_last_weapon"/>
        <Binding input="mouse:wheel" action="update" signal="select_throwable_analogue_check"/>

		<Binding input="kb:1" action="press" signal="select_weapon_slot0"/>
		<Binding input="kb:2" action="press" signal="select_weapon_slot2"/>
		<Binding input="kb:3" action="press" signal="select_IED_explosive"/>
		<Binding input="kb:3" action="press" signal="select_proximity_mine" secondary="1"/> <!-- Only one explosive type can be in the inventory in MP, so this key equips both. -->
        <Binding input="kb:4" action="press" signal="select_repair_tool"/>

		<!-- All weapon keys bring up the inventory wheel if held -->
		<Binding input="kb:x" action="hold" signal="open_inventory"/>
		<Binding input="kb:1" action="hold" signal="open_inventory"/>
		<Binding input="kb:2" action="hold" signal="open_inventory"/>
		<Binding input="kb:3" action="hold" signal="open_inventory"/>
        <Binding input="kb:4" action="hold" signal="open_inventory"/>

		<Binding input="kb:x" action="release" signal="close_inventory"/>
		<Binding input="kb:1" action="release" signal="close_inventory"/>
		<Binding input="kb:2" action="release" signal="close_inventory"/>
		<Binding input="kb:3" action="release" signal="close_inventory"/>
        <Binding input="kb:4" action="release" signal="close_inventory"/>
	</ActionMap>

