    <Control name="OPTIONS_CONTROLS_PC_PRIMARY_WEAPON"     key1="kb:1"     actionmap="common_multiplayer_remap"      group="8" conflictmask="9"  oasissection="Controls"/>
    <Control name="OPTIONS_CONTROLS_PC_SECONDARY_WEAPON"   key1="kb:2"     actionmap="common_multiplayer_remap"      group="8" conflictmask="9"  oasissection="Controls"/>
	<Control name="OPTIONS_CONTROLS_C4MINE"                key1="kb:3"     actionmap="common_multiplayer_remap"      group="8" conflictmask="9"  oasissection="Options - Controls"/>
	<Control name="OPTIONS_CONTROLS_REPAIRTOOL"            key1="kb:4"     actionmap="common_multiplayer_remap"      group="8" conflictmask="9"  oasissection="Options - Controls"/>
	<Control name="OPTIONS_CONTROLS_PC_BUDDY_BOOST"        key1="kb:5"     actionmap="common_multiplayer_remap"      group="8" conflictmask="9"  oasissection="Controls"/>
