	<Control name="OPTIONS_CONTROLS_MAP"                   key1="kb:m"      actionmap="common_map_remap"             group="1" conflictmask="13" oasissection="Options - Controls"/>
  </Category>
  <Category name="CATEGORY_VEHICLES">
