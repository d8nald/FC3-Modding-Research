    <Control name="OPTIONS_CONTROLS_PC_STEER_RIGHT"        key1="kb:d"     actionmap="common_driving_remap"          group="2" conflictmask="2"  oasissection="Controls"/>
    <Control name="OPTIONS_CONTROLS_PC_HEADLIGHTS_ONOFF"   key1="kb:g"     actionmap="common_driving_remap"          group="2" conflictmask="2"  oasissection="Controls"/>
    <Control name="OPTIONS_CONTROLS_HANDBRAKE"             key1="kb:space" actionmap="common_driving_remap"          group="2" conflictmask="2"  oasissection="Options - Controls"/>
    <Control name="OPTIONS_CONTROLS_SWITCHSEATS"           key1="kb:c"     actionmap="common_changeseat_remap"       group="2" conflictmask="2"  oasissection="Options - Controls"/>
<!--<Control name="OPTIONS_CONTROLS_PC_EXIT_VEHICLE"       key1="kb:e"     actionmap="common_exitvehicle_remap"      group="2" conflictmask="2"  oasissection="Controls"/> Using the interact button for exiting vehicles now. -->
