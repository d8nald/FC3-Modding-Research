<?xml version="1.0" encoding="utf-8"?>
<materialdescriptor xmlns:xi="#" name="Generic_FC3" id="#(0x2af2b8e, 0x857b9254)" version="9">
    <geometryInputs normal="1" tangent="1" binormal="1" color="1" uvChannels="2" />

    <parameter name="AlphaTestEnabled" type="bool" />
    <parameter name="TwoSided" type="bool" />
    <parameter name="BlendingType" type="int" />
    <parameter name="Billboard" type="bool" /> 
    <parameter name="Polidori" type="bool" />   
    <parameter name="FakeReflection" type="bool" />
    <parameter name="ReflectionPower" type="float" defaultvalue="1" />
    <parameter name="AmbientSpecularMultiplier" type="float" defaultvalue="0.1" />
    
    <parameter name="DiffuseTexture1" type="sampler2D" tilingName="DiffuseTiling1" UvName="UVGroupMapChannel1" />
    <parameter name="DiffuseTexture2" type="sampler2D" tilingName="DiffuseTiling2" UvName="UVGroupMapChannel2" VCMaskChannel="8" useDefine="DIFFUSE_MAP_DETAIL" />
   
    <parameter name="DiffuseTiling1" type="float2" defaultvalue="1,1" />
    <parameter name="DiffuseColor1" type="color4" defaultvalue="1,1,1,1" multiplier="1" />

    <parameter name="DiffuseTiling2" type="float2" defaultvalue="1,1" />
    <parameter name="DiffuseColor2" type="color4" defaultvalue="1,1,1,1" multiplier="1" />

    <parameter name="MaskTexture1" type="sampler2D" tilingName="MaskTiling1" UvName="UVGroupMapChannel0" replaceTexture="white" />

    <parameter name="MaskTiling1" type="float2" ignore="1" defaultvalue="1,1" />
    <parameter name="MaskTexture1Priority" type="int" defaultvalue="2" />

    <parameter name="Glossiness" type="float2" defaultvalue="0.5,0.5" />
    <parameter name="Normal1Modifier" type="float" defaultvalue="1.0" displayInMax="1"/>
    <parameter name="Normal1MaskModifier" type="float" defaultvalue="1.0" displayInMax="1"/>

    <parameter name="NormalAndGlossinessModifiers" type="float4" defaultvalue="1.0,1.0,0.0,0.0" provideronly="1" />
    <parameter name="SpecularReflectance" type="float4" defaultvalue="0.03,0.03,0.0,0.0" />
    
    <parameter name="NormalTexture1" type="sampler2D" tilingName="NormalTiling1" UvName="UVGroupMapChannel3" replaceTexture="normal" />
    <parameter name="NormalTiling1" type="float2" defaultvalue="1,1" />
    <parameter name="NormalTexture1Priority" type="int" defaultvalue="3" />

    <!-- For an hisorical reason, SpecularTiling1 is used as the tiling of the noise -->
    <parameter name="SpecularTexture" type="sampler2D" tilingName="SpecularTiling1" UvName="NoiseUV" uvTilingName="NoiseUVTiling" useDefine="SPECULARMAP" />
    <parameter name="SpecularTiling1" type="float2" defaultvalue="1,1" />

    <parameter name="UVGroupMapChannel0" type="int" />
    <!-- UVGroupMapChannel1 is used by two textures! -->
    <parameter name="UVGroupMapChannel1" type="int" />
    <parameter name="UVGroupMapChannel2" type="int" />
    <parameter name="UVGroupMapChannel3" type="int" />
    <parameter name="NoiseUV" type="int" />

    <parameter name="DiffuseTiling1AndGroup1" type="float4" defaultvalue="1,1,0,0" provideronly="1" />
    <parameter name="DiffuseTiling2AndGroup2" type="float4" defaultvalue="1,1,0,0" provideronly="1" />
    <parameter name="NormalTiling1AndGroup3" type="float4" defaultvalue="1,1,0,0" provideronly="1" />
    <parameter name="MaskTiling1AndGroup0" type="float4" defaultvalue="1,1,0,0" provideronly="1" />
    <parameter name="NoiseUVTiling" type="float4" defaultvalue="1,1,0,0" provideronly="1" />
    
    <parameter name="NoiseAmpOff" type="float2" defaultvalue="0.0,0.0" displayInMax="1"/>
    <parameter name="MaskSharpness" type="float" defaultvalue="1.0" displayInMax="1"/>
    <parameter name="MaskModifier" type="float4" defaultvalue="1,0,0,0" displayInMax="0"/>
    <parameter name="BurnMultiplier" type="float" defaultvalue="1"/>
    
    <parameterprovider parametersfilename="Mesh_Generic_FC3.parameters.inc.fx">
        <parameter name="Billboard" />
        <parameter name="Polidori" />
        <parameter name="FakeReflection" />
        <parameter name="ReflectionPower" />
        <parameter name="DiffuseTexture1">
            <alias name="DiffuseTexture1Shadow" />
        </parameter>
        <parameter name="DiffuseColor1" />
        <parameter name="DiffuseTexture2" />
        <parameter name="DiffuseColor2" />
        <parameter name="MaskTexture1" />
        <parameter name="NormalAndGlossinessModifiers" />
        <parameter name="SpecularReflectance" />
        <parameter name="NormalTexture1" />
        <parameter name="DiffuseTiling1AndGroup1" />
        <parameter name="DiffuseTiling2AndGroup2" />
        <parameter name="NormalTiling1AndGroup3" />
        <parameter name="NoiseUVTiling" />
        <parameter name="SpecularTexture" />
        <parameter name="MaskTiling1AndGroup0" />
        <parameter name="NoiseAmpOff" />
        <parameter name="MaskSharpness" />
        <parameter name="MaskModifier" />
        <parameter name="AmbientSpecularMultiplier" />
        <parameter name="BurnMultiplier" />
    </parameterprovider>

    <ui>
        <xi:include href="../MaterialUIInclude.xml" />
        
        <group horizontal="1" label="Settings">
            <group>
                <checkbox label="Two sided" dataBindings="TwoSided" />
                <checkbox label="Alpha test" dataBindings="AlphaTestEnabled" />
            </group>
        </group>

        <group label="Masks">
            <group label="Mask Map Info">
                <label>r = Specular gloss</label>
                <label>g = Diffuse maps mask</label>
                <label>b = Normal maps mask</label>
            </group>
            
            <group horizontal="1">
                <button dataBindings="MaskTexture1" fill="1" />
                <textbox dataBindings="UVGroupMapChannel0">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group horizontal="0">       
                    <textbox dataBindings="MaskTiling1.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="MaskTiling1.y">
                        <dataBindings class="Tiling" />
                    </textbox>
                </group>
            </group>
        </group>
        <group label="Diffuse">
            <label>Texture 1</label>
            <group horizontal="1">
                <button dataBindings="DiffuseColor1" overridableInDerivation="1">
                    <dataBindings type="color" />
                </button>
                <button dataBindings="DiffuseTexture1" fill="1" />
                <textbox dataBindings="UVGroupMapChannel1">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group>
                    <textbox dataBindings="DiffuseTiling1.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="DiffuseTiling1.y">
                        <dataBindings class="Tiling" />
                    </textbox>
                </group>
            </group>
            
            <label>Texture 2</label>
            <group horizontal="1">
                <button dataBindings="DiffuseColor2" overridableInDerivation="1">
                    <dataBindings type="color" />
                </button>
                <button dataBindings="DiffuseTexture2" fill="1" />
                <textbox dataBindings="UVGroupMapChannel2">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group>
                    <textbox dataBindings="DiffuseTiling2.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="DiffuseTiling2.y">
                        <dataBindings class="Tiling" />
                    </textbox>
                </group>
            </group>
        </group>

        <group label="Specular">
            <group horizontal="1">
                <label>Glossiness (black mask)</label>
                <textbox dataBindings="Glossiness.x" overridableInDerivation="1">
                    <dataBindings type="ZeroPositiveCff" minvalue="0.0" maxvalue="1.0" defaultvalue="0.5" />
                </textbox>
                <label>Glossiness (white mask)</label>
                <textbox dataBindings="Glossiness.y" overridableInDerivation="1">
                    <dataBindings type="ZeroPositiveCff" minvalue="0.0" maxvalue="1.0" defaultvalue="0.5" />
                </textbox>
            </group>
            <group>
                <label>THESE SHOULD BE KEPT AT 0.03 FOR EVERY NON-METAL MATERIAL</label>
            </group>
            <group horizontal="1">
                <label>Specular reflectance (black mask)</label>
                <textbox dataBindings="SpecularReflectance.x" overridableInDerivation="1">
                    <dataBindings type="ZeroPositiveCff" minvalue="0.02" maxvalue="1.0" defaultvalue="0.03" />
                </textbox>
                <label>Specular reflectance (white mask)</label>
                <textbox dataBindings="SpecularReflectance.y" overridableInDerivation="1">
                    <dataBindings type="ZeroPositiveCff" minvalue="0.02" maxvalue="1.0" defaultvalue="0.03" />
                </textbox>
            </group>
        </group>

        <group label="Normal">
            <label>Normal 1</label>
            <group horizontal="1"> 
                <button dataBindings="NormalTexture1" fill="1" />
                <textbox dataBindings="UVGroupMapChannel3">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group>
                    <textbox dataBindings="NormalTiling1.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="NormalTiling1.y">
                            <dataBindings class="Tiling" />
                    </textbox>
                </group>
            </group>
        </group>
        
        <group horizontal="1" label="Modifiers">
            <label>Normal1 modifier (Mask = 0)</label>
            <textbox databindings="Normal1Modifier" minvalue="0.01" defaultvalue="1" />
            <label>Normal1 modifier (Mask = 1)</label>
            <textbox databindings="Normal1MaskModifier" minvalue="0.01" defaultvalue="1" />
        </group>

        <label>Specular Texture</label>
        <group horizontal="1">
            <group label="Specular Info">
                <label>r = Specular occlusion</label>
                <label>g = Specular gloss</label>
                <label>b = Unused</label>
            </group>
            <button dataBindings="SpecularTexture" fill="1" />
            <group>
                <textbox dataBindings="SpecularTiling1.x">
                    <dataBindings class="Tiling" />
                </textbox>
                <textbox dataBindings="SpecularTiling1.y">
                    <dataBindings class="Tiling" />
                </textbox>
            </group>
        </group>
        

        <group horizontal="1" label="Mask modifier">
            <checkbox label="Use mask modifier" dataBindings="Polidori"/>
            <label>        Mask offset</label> 
                <textbox databindings="NoiseAmpOff.y">
                    <dataBindings class="HighPrecisionFloat" />
                </textbox>
            <label>MaskSharpness</label> <textbox databindings="MaskSharpness" minvalue="0.01" defaultvalue="1" />
        </group>
    </ui>
</materialdescriptor>