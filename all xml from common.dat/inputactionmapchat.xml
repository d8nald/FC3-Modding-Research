<?xml version="1.0" encoding="ISO-8859-1" ?>

<Root>
	<!-- Note: This actionmap is actually used for the key binding screen and should probably be renamed since the Fire input is now used for chat. -->
	<!-- Any action that you want bindable/remapable should be placed in this file. -->
	<!-- ******************************************************************************** -->
	<ActionMap name="chat" resendOnChange="0">

    <Import actionmap="common_voicechat" optional=""/>
    		<!--splitscreen support bindings-->
		<Binding input="pad:left" action="press" signal="toggle_splitscreen_player_login"/>
		<Binding input="pad:x" action="release" signal="toggle_splitscreen_player_activation"/>
	
		<CompoundInput name="leftright" device="kb">
			<Input input="right" axis="0" />
			<Input input="numpadright" axis="0" />
			<Input input="left" axis="0" invert="1" />
			<Input input="numpadleft" axis="0" invert="1" />
		</CompoundInput>
		<CompoundInput name="pgupdown" device="kb">
			<Input input="pgup" axis="0" />
			<Input input="numpadpgup" axis="0" />
			<Input input="pgdown" axis="0" invert="1" />
			<Input input="numpadpgdown" axis="0" invert="1" />
		</CompoundInput>


		<Binding signal="chat_copy">
			<Input input="kb:lctrl" action="press"/>
			<Input input="kb:c" action="press"/>
		</Binding>
		<Binding signal="chat_paste">
			<Input input="kb:lctrl" action="press"/>
			<Input input="kb:v" action="press"/>
		</Binding>

		<Binding input="kb:backspace" action="press" signal="chat_backspace" />
		<Binding input="kb:backspace" action="release" signal="chat_backspace_release" />
		
		<Binding input="kb:delete" action="press" signal="chat_delete" />
        <Binding input="kb:delete" action="release" signal="chat_delete_release" />
		<Binding input="kb:numpaddelete" action="press" signal="chat_delete" />
        <Binding input="kb:numpaddelete" action="release" signal="chat_delete_release" />
        
        <Binding input="kb:return" action="press" signal="chat_execute_buffer" />
        <Binding input="kb:numpadreturn" action="press" signal="chat_execute_buffer" />
        
		<Binding input="kb:end" action="press" signal="chat_cursor_end" />
		<Binding input="kb:home" action="press" signal="chat_cursor_start" />
		<Binding input="kb:leftright" action="press" signal="chat_cursor_leftright" />
		<Binding input="kb:leftright" action="release" signal="chat_cursor_leftright_release" />

		
		<Binding input="kb:lalt" action="press" signal="chat_lalt" />
		<Binding input="kb:ralt" action="press" signal="chat_ralt" />
		<Binding input="kb:lshift" action="press" signal="chat_lshift"/>
		<Binding input="kb:rshift" action="press" signal="chat_rshift"/>
		<Binding input="kb:lctrl" action="press" signal="chat_lctrl"/>
        <Binding input="kb:rctrl" action="press" signal="chat_rctrl"/>
		
		<Binding input="mouse:4b" action="press" signal="chat_mouse_4b" />
